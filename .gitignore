# ============================================================================
# ARCHIVO: .gitignore
# PROPÓSITO: Especifica archivos y directorios que Git debe ignorar.
# ============================================================================

# Resúmenes de clases académicas (opcional)
resumenes_clases/
project_plan.md

# Caché de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales de desarrollo
.venv/
venv/
ENV/
env/

# Secretos y configuraciones sensibles (¡NUNCA subir contraseñas a GitHub!)
.env
.env.test

# IDEs y editores de código
.vscode/
.idea/
*.log

# Suite de Pruebas y Reportes de Cobertura
.pytest_cache/
.coverage
htmlcov/

# Módulos y dependencias locales
node_modules/
package-lock.json

# Exclusión de carpeta de documentación para GitHub (Requerimiento del usuario)
documentacion/
resumenes_clases/
project_plan.md
